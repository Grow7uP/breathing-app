.page {
  position: relative;
  min-height: 100vh;
  padding: 32rpx 40rpx 60rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  overflow: hidden;
  background: linear-gradient(180deg, #0B2230 0%, #123C50 100%);
}

.glow {
  position: absolute;
  border-radius: 50%;
  filter: blur(60rpx);
  opacity: 0.35;
  pointer-events: none;
}
.glow-1 {
  width: 420rpx; height: 420rpx; top: -120rpx; left: -120rpx;
  background: radial-gradient(circle, #2E9C92 0%, transparent 70%);
}
.glow-2 {
  width: 460rpx; height: 460rpx; bottom: -140rpx; right: -140rpx;
  background: radial-gradient(circle, #1F6FB5 0%, transparent 70%);
}

/* 方法切换 */
.method-bar {
  position: relative;
  z-index: 2;
  width: 100%;
  white-space: nowrap;
  margin-bottom: 24rpx;
}
.method-chip {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 34rpx;
  margin-right: 20rpx;
  border-radius: 20rpx;
  background: rgba(255,255,255,0.07);
  border: 1rpx solid rgba(255,255,255,0.1);
  transition: all 0.3s;
}
.method-chip.active {
  background: rgba(79, 209, 197, 0.18);
  border-color: #4FD1C5;
}
.chip-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #E8F4F1;
}
.chip-en {
  font-size: 19rpx;
  margin-top: 4rpx;
  color: rgba(232,244,241,0.55);
}
.method-chip.active .chip-name { color: #FFFFFF; }
.method-chip.active .chip-en { color: #7BE8DD; }

/* 方法信息 */
.method-info {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 44rpx;
  flex-wrap: wrap;
  justify-content: center;
  padding: 0 10rpx;
}
.evi-badge {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255,255,255,0.08);
  color: rgba(232,244,241,0.7);
}
.evi-badge.strong {
  background: rgba(79,209,197,0.15);
  color: #7BE8DD;
}
.tagline {
  font-size: 24rpx;
  color: rgba(232,244,241,0.7);
  text-align: center;
}

/* 呼吸圆 */
.breath-wrap {
  position: relative;
  z-index: 2;
  width: 460rpx;
  height: 460rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.ring-outer {
  width: 100%; height: 100%;
  border: 2rpx solid rgba(79, 209, 197, 0.18);
  border-radius: 50%;
}
.ring-inner {
  width: 100%; height: 100%;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.1s linear;
}
.ring-fill {
  width: 100%; height: 100%;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 30%, #53D6CB 0%, #2E9C92 40%, #175B68 100%);
  box-shadow: 0 0 60rpx rgba(79, 209, 197, 0.45), inset 0 0 30rpx rgba(255,255,255,0.18);
  opacity: 0.92;
}
.circle-center {
  position: absolute;
  z-index: 3;
  width: 100%; height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.phase-text {
  font-size: 48rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 8rpx;
  text-shadow: 0 2rpx 20rpx rgba(0,0,0,0.25);
}
.countdown {
  margin-top: 10rpx;
  font-size: 72rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1.1;
}
.countdown .unit { font-size: 30rpx; font-weight: 400; margin-left: 6rpx; color: rgba(255,255,255,0.75); }
.done-mark { color: #7BE8DD; }
.tip {
  margin-top: 18rpx;
  font-size: 24rpx;
  color: rgba(232, 244, 241, 0.8);
  padding: 0 40rpx;
  text-align: center;
}

/* 循环进度 */
.cycle-row {
  position: relative;
  z-index: 2;
  margin-top: 44rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.cycle-dots { display: flex; gap: 12rpx; }
.cycle-dot {
  width: 16rpx; height: 16rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.18);
  transition: background 0.3s;
}
.cycle-dot.filled { background: #4FD1C5; }
.cycle-label { font-size: 24rpx; color: rgba(232, 244, 241, 0.75); }

/* 控制 */
.controls {
  position: relative;
  z-index: 2;
  margin-top: 44rpx;
  display: flex;
  gap: 24rpx;
  align-items: center;
  justify-content: center;
}
.btn {
  min-width: 200rpx;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  padding: 0;
  margin: 0;
  text-align: center;
  border: none;
}
.btn::after { border: none; }
.btn-primary {
  background: linear-gradient(135deg, #4FD1C5, #2E9C92);
  color: #06221F;
  box-shadow: 0 12rpx 30rpx rgba(79, 209, 197, 0.35);
}
.btn-ghost {
  background: rgba(255,255,255,0.10);
  color: #E8F4F1;
  border: 1rpx solid rgba(255,255,255,0.18);
}

/* 自定义节奏按钮 */
.custom-btn {
  position: relative;
  z-index: 2;
  margin-top: 30rpx;
  padding: 20rpx 36rpx;
  border-radius: 16rpx;
  background: rgba(255,255,255,0.06);
  border: 1rpx dashed rgba(79,209,197,0.4);
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
  color: #7BE8DD;
}
.custom-gear { font-size: 30rpx; }

/* 分享入口 */
.share-row {
  position: relative;
  z-index: 2;
  margin-top: 24rpx;
  display: flex;
  gap: 20rpx;
  justify-content: center;
}
.share-btn {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 16rpx 32rpx;
  border-radius: 999rpx;
  background: rgba(255,255,255,0.08);
  border: 1rpx solid rgba(255,255,255,0.14);
  font-size: 25rpx;
  color: #E8F4F1;
  line-height: 1.4;
}
button.share-btn::after { border: none; }
.share-btn .share-icon { font-size: 28rpx; color: #7BE8DD; }

/* 说明 */
.info {
  position: relative;
  z-index: 2;
  width: 100%;
  margin-top: 32rpx;
  background: rgba(255,255,255,0.06);
  border-radius: 20rpx;
  padding: 26rpx 28rpx;
  box-sizing: border-box;
}
.info-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 28rpx;
  font-weight: 600;
  color: #E8F4F1;
}
.chevron { margin-left: 8rpx; font-size: 32rpx; color: rgba(232,244,241,0.5); transition: transform 0.3s; }
.chevron.open { transform: rotate(90deg); }
.info-body { margin-top: 20rpx; }
.info-desc { font-size: 26rpx; color: rgba(232,244,241,0.8); line-height: 1.7; }
.info-phases {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 18rpx;
}
.info-phase {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 14rpx 22rpx;
  border-radius: 14rpx;
  background: rgba(79,209,197,0.12);
}
.info-phase-text { font-size: 24rpx; color: #7BE8DD; }
.info-phase-dur { font-size: 22rpx; margin-top: 6rpx; color: rgba(232,244,241,0.8); }
.disclaimer {
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(255,255,255,0.1);
  font-size: 23rpx;
  color: rgba(232,244,241,0.5);
  line-height: 1.6;
}

.footer {
  position: relative;
  z-index: 2;
  margin-top: 36rpx;
  font-size: 22rpx;
  color: rgba(232,244,241,0.4);
  letter-spacing: 4rpx;
}

/* 自定义面板 */
.sheet-mask {
  position: fixed;
  z-index: 10;
  left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
}
.sheet {
  position: fixed;
  z-index: 11;
  left: 0; right: 0; bottom: 0;
  background: #12303F;
  border-radius: 28rpx 28rpx 0 0;
  padding: 32rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  animation: slideUp 0.25s ease;
}
@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}
.sheet-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
}
.sheet-close { font-size: 30rpx; color: rgba(232,244,241,0.6); padding: 8rpx; }
.sheet-tip { margin-top: 8rpx; font-size: 22rpx; color: rgba(232,244,241,0.55); }
.phase-edit {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 1rpx solid rgba(255,255,255,0.08);
}
.phase-name { font-size: 28rpx; color: #E8F4F1; }
.stepper { display: flex; align-items: center; gap: 20rpx; }
.step-btn {
  width: 56rpx; height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  border-radius: 14rpx;
  background: rgba(255,255,255,0.1);
  color: #7BE8DD;
  font-size: 32rpx;
  border: 1rpx solid rgba(255,255,255,0.12);
}
.step-val { min-width: 90rpx; text-align: center; font-size: 30rpx; color: #FFFFFF; font-weight: 600; }
.sheet-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 32rpx;
}
.sheet-actions .btn { flex: 1; }
.sheet-actions .sm { min-width: 0; }
